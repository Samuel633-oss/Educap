# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
# Free models change often: pick one from https://openrouter.ai/models?max_price=0
EDUCAP_STRONG_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Cheap/fast model for routing + memory extraction (can be the same model)
EDUCAP_FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Tried in order if the main model is rate-limited (free models often are)
EDUCAP_FALLBACK_MODELS=google/gemma-3-27b-it:free,mistralai/mistral-small-3.2-24b-instruct:free

# --- Database ---
# SQLite works out of the box. For Postgres:
# DATABASE_URL=postgresql+psycopg://educap:educap@localhost:5432/educap
DATABASE_URL=sqlite:///./educap.db

# --- Embeddings ---
# "hashing" = free, local, no API. "openai" = any OpenAI-compatible /embeddings endpoint.
EMBEDDING_PROVIDER=hashing
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

CORS_ORIGINS=http://localhost:3000
