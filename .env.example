# Put this file at:  educap/backend/.env   (NEVER commit it to GitHub)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Free models change often. Full list: see free_models.md
EDUCAP_STRONG_MODEL=google/gemma-4-31b-it:free
EDUCAP_FAST_MODEL=google/gemma-4-31b-it:free
# Tried in order if the main model is rate-limited. openrouter/free picks any free model.
EDUCAP_FALLBACK_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free

# SQLite is fine locally. On Streamlit Cloud use a free Postgres URL (see DEPLOY.md).
DATABASE_URL=sqlite:///./educap.db

# free, local, no API needed
EMBEDDING_PROVIDER=hashing

# Optional: require a password before anyone can even see the login screen
# APP_PASSWORD=choose-something
