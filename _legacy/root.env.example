# Get a free key at https://openrouter.ai/keys  (never commit the real .env)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Small/cheap model for routing. Same free model is fine to start.
OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free
# SQLite for Phase 1-2. Switch to Postgres later:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/educap
DATABASE_URL=sqlite:///./educap.db
